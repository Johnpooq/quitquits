{
  "name": "workday-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/src/index.ts",
    "start:api": "tsx server/src/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate --config server/drizzle.config.ts",
    "knowledge": "node scripts/build-knowledge.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\""
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@hono/node-server": "2.1.3",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "lucide-react": "^0.468.0",
    "pg": "8.23.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "9.2.1",
    "drizzle-kit": "0.31.11",
    "prettier": "3.9.9",
    "tailwindcss": "^4.1.0",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "vite": "^6.4.0",
    "vitest": "^3.2.0"
  }
}
