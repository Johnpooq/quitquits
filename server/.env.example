# 复制为 server/.env 后按需修改。这个文件只在服务端读取，前端拿不到。

# 监听地址与端口（Vite 开发服务器会把 /api 代理到这里）
HOST=127.0.0.1
PORT=8787

# 数据库：设置 DATABASE_URL 就连 Postgres（docker compose up -d 起的那个）；
# 不设置则用 PGlite（WASM 版 Postgres，同一套表结构与迁移），数据写在 PGLITE_DIR。
# DATABASE_URL=postgres://quitquit:quitquit@127.0.0.1:5432/quitquit
PGLITE_DIR=server/data/pglite

# 上传文件的本地磁盘目录（元数据在数据库里）
STORAGE_DIR=server/storage

# 真实模型：OpenAI 兼容的 /chat/completions 接口。不填 LLM_API_KEY 就使用规则模板（界面显示「模拟 AI」）。
# 例：DeepSeek  LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
#     通义千问  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_MS=20000
